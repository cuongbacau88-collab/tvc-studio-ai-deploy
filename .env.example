# TVC Studio AI - Environment Configuration
# Copy this file to .env and customize for your environment
# Do NOT commit .env to version control

# Python Environment
PYTHON_VERSION=3.11
ALLOW_FLASHATTENTION=0

# Model Directories
# Paths for downloaded models from Hugging Face
MODELS_DIR=./models
WEIGHTS_DIR=./weights

# SCAIL-2 Configuration
SCAIL2_REPO_PATH=./repos/SCAIL-2
SCAIL2_VENV_PATH=./venv/scail2
SCAIL2_MODEL_PATH=${MODELS_DIR}/scail2

# Wan2.2 Configuration
WAN22_REPO_PATH=./repos/Wan2.2
WAN22_VENV_PATH=./venv/wan22
WAN22_MODEL_PATH=${MODELS_DIR}/wan22-animate

# Fashn Virtual Try-On Configuration
FASHN_VTON_REPO_PATH=./repos/fashn-vton-1.5
FASHN_VTON_VENV_PATH=./venv/fashn-vton
FASHN_VTON_MODEL_PATH=${MODELS_DIR}/fashn-vton

# Qwen Image Edit Configuration (Scene Editing)
QWEN_IMAGE_EDIT_REPO_PATH=./repos/Qwen-Image
QWEN_IMAGE_EDIT_VENV_PATH=./venv/qwen-image-edit
QWEN_IMAGE_EDIT_MODEL_PATH=${MODELS_DIR}/qwen-image-edit

# BiRefNet Configuration (Background Removal - Optional)
BIREFNET_REPO_PATH=./repos/BiRefNet
BIREFNET_VENV_PATH=./venv/qwen-image-edit
BIREFNET_MODEL_PATH=${MODELS_DIR}/birefnet

# IC-Light Configuration (Lighting Sync - Optional)
IC_LIGHT_REPO_PATH=./repos/IC-Light
IC_LIGHT_VENV_PATH=./venv/qwen-image-edit
IC_LIGHT_MODEL_PATH=${MODELS_DIR}/ic-light

# SeedVR2 Configuration (Video Restoration)
SEEDVR2_REPO_PATH=./repos/SeedVR2
SEEDVR2_VENV_PATH=./venv/seedvr2
SEEDVR2_MODEL_PATH=${MODELS_DIR}/seedvr2

# Real-ESRGAN Configuration (Fast Upscaling)
REALESRGAN_REPO_PATH=./repos/Real-ESRGAN
REALESRGAN_VENV_PATH=./venv/realesrgan
REALESRGAN_MODEL_PATH=${MODELS_DIR}/realesrgan

# CodeFormer Configuration (Face Restoration)
CODEFORMER_REPO_PATH=./repos/CodeFormer
CODEFORMER_VENV_PATH=./venv/codeformer
CODEFORMER_MODEL_PATH=${MODELS_DIR}/codeformer
# Fidelity control: 0.0 (high quality) to 1.0 (preserve identity, default 0.85)
CODEFORMER_FIDELITY=0.85

# Application Configuration
# API Server settings
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false

# Model Loading
# Set to false to manually manage model initialization
AUTO_LOAD_MODELS=false

# Output Configuration
OUTPUT_DIR=./outputs
LOG_DIR=./logs
CHECKPOINT_DIR=./checkpoints
UPLOAD_DIR=./uploads

# GPU Configuration
# Leave empty to auto-detect, or specify GPU index (0, 1, etc.)
GPU_INDEX=
# Maximum GPU memory to use (in GB), leave empty for auto
MAX_GPU_MEMORY=

# Performance Settings
# Number of workers for data loading
NUM_WORKERS=4
# Batch size for processing
BATCH_SIZE=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CUDA Configuration
# Uncomment and set if you need specific CUDA settings
# CUDA_VISIBLE_DEVICES=0
# CUDA_LAUNCH_BLOCKING=1

# Multi-GPU Configuration (Server Deployment)
# For distributed inference with FSDP or DeepSpeed
ENABLE_MULTI_GPU=false
FSDP_ENABLED=false
ULYSSES_SIZE=8  # Number of GPUs for Ulysses parallelism (sequence parallel)
DEEPSPEED_CONFIG=./configs/deepspeed-config.json

# Model Offloading (Single-GPU / Limited VRAM)
# Enable to move model layers between GPU and CPU RAM
ENABLE_MODEL_OFFLOAD=false
ENABLE_T5_CPU=false  # Move T5 text encoder to CPU (saves 4-6GB VRAM)
ENABLE_QUANTIZATION=false  # FP8 quantization for 50% VRAM reduction
QUANTIZATION_DTYPE=fp8  # Options: fp8, int8 (fp8 recommended)

# GPU Memory Optimization
# Maximum VRAM per task in GB (0 = auto-detect)
MAX_VRAM_PER_TASK_GB=24
# Fallback to CPU inference if GPU insufficient
FALLBACK_TO_CPU=false

# GPU Inference Optimization (for Phase 3 API)
# Sequential task queue ensures only one model runs at a time
# This prevents GPU OOM from concurrent model execution
SEQUENTIAL_GPU_QUEUE=true
GPU_TASK_TIMEOUT_SECONDS=3600  # 1 hour timeout per task

# Optional: Hugging Face Token
# Required if downloading private models
HF_TOKEN=

# Optional: Model Registry URLs
# Override default model locations if using custom storage
# SCAIL2_MODEL_URL=https://huggingface.co/zai-org/SCAIL-2
# WAN22_MODEL_URL=https://huggingface.co/Wan-AI/Wan2.2-Animate-14B


# Phase 4A authenticated GPU API
# Leave the example token empty; set a long random value in the deployment environment.
GPU_API_SERVICE_TOKEN=
GPU_UPLOAD_DIR=./uploads
GPU_OUTPUT_DIR=./outputs
GPU_MAX_UPLOAD_MB=300
